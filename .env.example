# KnockOutIQ — Environment Variables
# Copy this file to .env and fill in your actual API keys.

# RapidAPI key for boxing-data.com (bengroves1993)
# Subscribe at: https://rapidapi.com/bengroves1993/api/boxing-data-api
RAPID_API_KEY=your_rapidapi_key_here

# The Odds API key — primary source for live boxing odds (52+ events)
# Free tier at: https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# OddsPapi API key for Pinnacle sharp reference lines
# Sign up at: https://oddspapi.io
ODDSPAPI_API_KEY=your_oddspapi_key_here

# BoxRec account credentials for historical fight data scraping
# Free account at: https://boxrec.com/en/register
BOXREC_USERNAME=your_boxrec_username_here
BOXREC_PASSWORD=your_boxrec_password_here
